# ==============================================================================
# Krishi-Saarthi Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to 'backend/.env' (or root '.env') and fill in your values.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your real '.env' file to Git or version control!
# 2. Keep your API keys and SECRET_KEY private and secure.
# 3. For production, generate a cryptographically strong SECRET_KEY:
#    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

APP_NAME=Krishi-Saarthi API
APP_VERSION=1.0.0
DEBUG=true

# Database (Default SQLite for instant local dev without Docker)
DATABASE_URL=sqlite+aiosqlite:///./krishi_saarthi.db
DATABASE_URL_SYNC=sqlite:///./krishi_saarthi.db

# Database (PostgreSQL for Docker or production deployment)
# DATABASE_URL=postgresql+asyncpg://krishi_admin:krishi_secure_2026@localhost:5432/krishi_saarthi_master
# DATABASE_URL_SYNC=postgresql+psycopg2://krishi_admin:krishi_secure_2026@localhost:5432/krishi_saarthi_master

REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External AI & GIS APIs
GEMINI_API_KEY=
GEMINI_RATE_LIMIT_PER_HOUR=15
CARTO_API_KEY=
CARTO_RATE_LIMIT_PER_HOUR=15

# Government Agricultural & Weather APIs
# Official Government of India Open Data API (data.gov.in)
# Dataset: Current Daily Price of Various Commodities from Various Markets (Mandi) - 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_API_KEY=YOUR_DATA_GOV_API_KEY_HERE
OGD_API_KEY=YOUR_DATA_GOV_API_KEY_HERE
AGMARKNET_API_KEY=
IMD_API_KEY=

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=krishiminio
MINIO_SECRET_KEY=minio_secure_2026
MINIO_BUCKET=krishi-saarthi

# Celery Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
