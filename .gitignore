# ==============================================================================
# Krishi-Saarthi - Global .gitignore
# Cross-Platform Protection: Flutter, Android, iOS, FastAPI, Node, ML, & Security
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. ENVIRONMENT, CREDENTIALS & SECRETS (STRICT - DO NOT REMOVE)
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.*
!backend/.env.example

# Secret keys, tokens, and certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks
credentials.json
service-account*.json
client_secret*.json

# ──────────────────────────────────────────────────────────────────────────────
# 2. FLUTTER, DART, AND MOBILE PLATFORMS
# ──────────────────────────────────────────────────────────────────────────────
**/build/
**/.dart_tool/
**/.packages
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
*.iml
.metadata

# Android Machine-Specific & Build Caches (CRITICAL)
**/android/local.properties
**/local.properties
**/android/.gradle/
**/.gradle/
**/buildOutputCleanup/
**/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/google-services.json

# iOS / macOS Ephemeral Build & Pods
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/
**/ios/profile/
**/ios/release/
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/GoogleService-Info.plist

# ──────────────────────────────────────────────────────────────────────────────
# 3. PYTHON / FASTAPI BACKEND
# ──────────────────────────────────────────────────────────────────────────────
venv/
**/venv/
.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
.eggs/
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage

# ──────────────────────────────────────────────────────────────────────────────
# 4. NODE / VITE / WEB FRONTEND
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
**/.vite/
.angular/
dist/

# ──────────────────────────────────────────────────────────────────────────────
# 5. DATABASE & RUNTIME STORAGE
# ──────────────────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*-journal
database/backups/*.sql

# ──────────────────────────────────────────────────────────────────────────────
# 6. LARGE ML MODEL WEIGHTS (Exceeds GitHub 100MB File Limit)
# ──────────────────────────────────────────────────────────────────────────────
models/*.gguf
models/*.bin
models/*.safetensors
models/*.pt
models/*.pth
models/*.onnx
models/*.tflite
models/*.h5
models/*.pb
*.gguf
*.onnx
*.tflite
*.pt
*.pth
*.h5
*.pb
*.bin
*.safetensors
!models/.gitkeep

# ──────────────────────────────────────────────────────────────────────────────
# 7. IDE, OS, AND AGENT CACHES
# ──────────────────────────────────────────────────────────────────────────────
.agents/
.DS_Store
**/.DS_Store
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
*.log
docker-compose.override.yml

<!-- Agri-Saarthi 2026 Sync -->
