# ==============================================================================
# Krishi-Saarthi - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root (or inside 'backend/.env')
# and replace placeholder values with your local or production credentials.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your real '.env' file to Git or version control!
# 2. Keep your API keys and SECRET_KEY private and secure.
# 3. For production, generate a cryptographically strong SECRET_KEY:
#    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# Application Configuration
APP_NAME=Krishi-Saarthi API
APP_VERSION=1.0.0
DEBUG=true

# Database Connection
# Default: Zero-configuration SQLite for immediate local development
DATABASE_URL=sqlite+aiosqlite:///./backend/krishi_saarthi.db
DATABASE_URL_SYNC=sqlite:///./backend/krishi_saarthi.db

# PostgreSQL (Production or Docker Dev):
# DATABASE_URL=postgresql+asyncpg://krishi_admin:krishi_secure_2026@localhost:5432/krishi_saarthi_master
# DATABASE_URL_SYNC=postgresql+psycopg2://krishi_admin:krishi_secure_2026@localhost:5432/krishi_saarthi_master

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
# Replace with a unique random secret in production
SECRET_KEY=change-this-to-a-secure-random-32-byte-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ──────────────────────────────────────────────────────────────────────────────
# AI & Agronomy Vision Services
# ──────────────────────────────────────────────────────────────────────────────
# Get your free Google Gemini API Key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# If left empty, Krishi-Saarthi automatically uses the offline ICAR agronomy
# rule-engine and quantized edge AI fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RATE_LIMIT_PER_HOUR=15

# ──────────────────────────────────────────────────────────────────────────────
# GIS & Basemaps (CARTO)
# ──────────────────────────────────────────────────────────────────────────────
# Optional: CARTO basemap access key. If left blank, free OpenStreetMap and
# standard CARTO public tiles will be used without rate penalties.
CARTO_API_KEY=
CARTO_RATE_LIMIT_PER_HOUR=15

# ──────────────────────────────────────────────────────────────────────────────
# Government Agricultural & Weather APIs (Optional)
# ──────────────────────────────────────────────────────────────────────────────
IMD_API_KEY=
AGMARKNET_API_KEY=
OGD_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Object Storage (MinIO / S3)
# ──────────────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=krishiminio
MINIO_SECRET_KEY=minio_secure_2026
MINIO_BUCKET=krishi-saarthi
MINIO_USE_SSL=false

# ──────────────────────────────────────────────────────────────────────────────
# Background Tasks (Celery & Redis)
# ──────────────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

<!-- Agri-Saarthi 2026 Sync -->
